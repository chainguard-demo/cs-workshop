<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- The registry ignores the username when the password is a session token -->
  <servers>
    <server>
      <id>chainguard</id>
      <username>_token</username>
      <password>${env.CGR_TOKEN}</password>
    </server>
  </servers>

  <!-- Route every repository, Maven Central included, through Chainguard.
       There is no client-side fallback; anything Chainguard cannot serve fails the build. -->
  <mirrors>
    <mirror>
      <id>chainguard</id>
      <mirrorOf>*</mirrorOf>
      <url>https://libraries.cgr.dev/java/</url>
    </mirror>
  </mirrors>
</settings>

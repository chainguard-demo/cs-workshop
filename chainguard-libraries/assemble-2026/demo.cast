[0.033, "o", "FROM cgr.dev/chainguard-private/python:3.13-dev\r\n\r\nWORKDIR /app\r\n\r\nCOPY pyproject.toml uv.lock ./\r\n\r\nRUN uv sync --frozen --no-install-project --no-cache\r\n\r\nCOPY src ./src\r\nENV PYTHONPATH=/app/src\r\n\r\nENTRYPOINT [\"/app/.venv/bin/python\", \"-m\", \"reportbot\"]\r\n"]
